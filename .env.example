# Basis data PostgreSQL (dipakai Node dan Python)
DATABASE_URL=postgres://optimus:GANTI_SANDI@localhost:5432/optimus
DB_PASSWORD=GANTI_SANDI_DB

# Server Node (Host port)
PORT=3004
PY_URL=http://127.0.0.1:8001
SESSION_DAYS=30
ALLOW_REGISTER=1          # 0 = tutup pendaftaran akun baru
MAX_BODY=60mb             # batas ukuran proyek yang disimpan (OSM besar bisa beberapa MB)
VERIFY_MAX_END=7200       # batas durasi simulasi SUMO asli (detik)
TRUST_PROXY=1             # 1 bila di belakang nginx/reverse proxy

# Layanan Python
SUMO_TIMEOUT=900
# SUMO_HOME=/usr/share/sumo   # bila memakai SUMO sistem, bukan paket pip eclipse-sumo
